<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:statusBarColor">#131825</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="colorAccent">#F6BD4B</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:navigationBarColor">#131825</item>
        <item name="android:alertDialogTheme">@style/AlertDialogTheme</item>
    </style>



    <style name="SplashTheme" parent="SplashScreen_SplashTheme" >
        <item name="android:statusBarColor" tools:targetApi="m">@color/bootsplash_background</item>
        <item name="android:colorPrimaryDark">@color/bootsplash_background</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>

    <style name="AlertDialogTheme" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:background">#1F2536</item>
        <item name="android:colorPrimary">#1F2536</item>
        <item name="android:colorAccent">#1F2536</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/NegativeButtonStyle</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/PositiveButtonStyle</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/PositiveButtonStyle</item>
    </style>

    <style name="Theme.FullScreenDialog">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>

        <item name="android:navigationBarColor">#131825</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="colorAccent">#F6BD4B</item>
    </style>

    <style name="NegativeButtonStyle" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">#F6BD4B</item>
    </style>

    <style name="NeutralButtonStyle" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">#F6BD4B</item>
    </style>

    <style name="PositiveButtonStyle" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">#F6BD4B</item>
    </style>

</resources>
